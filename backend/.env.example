# Copy to .env (gitignored) for `docker compose up`.

# Pre-baked UUID treated as the signed-in user when no session exists.
# Local development only; never set this in production.
DEV_FAKE_USER=00000000-0000-0000-0000-000000000001

# Spring Boot listens on 0.0.0.0:8000; compose maps that to localhost:8000.
DATABASE_URL=jdbc:postgresql://db:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=app
PUBLIC_APP_URL=https://morrow.coders.kr
AUTH_MODE=standalone

# Social login. Never commit real secrets.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://morrow.coders.kr/api/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://morrow.coders.kr/api/auth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://morrow.coders.kr/api/auth/google/callback

# Free bot protection and Kakao date-place discovery. Map keys may come from
# a different Kakao app than KAKAO_CLIENT_ID when that app owns free quota.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
KAKAO_MAP_REST_KEY=
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# Managed Redis + object storage. Injected by coders.yaml in production.
REDIS_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Required before iOS social-login submission when Apple Sign In applies.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Comma-separated coders.kr user UUIDs that may use the moderation console.
# Set this as a production secret; do not commit real identifiers.
ADMIN_CODERS_IDS=
